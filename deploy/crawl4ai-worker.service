[Unit]
Description=Crawl4AI Background Worker (arq)
After=network.target redis.service

[Service]
Type=simple
User=himanshu
Group=himanshu
WorkingDirectory=/home/himanshu/workspace/ai-agent/crawl4AI
EnvironmentFile=/home/himanshu/workspace/ai-agent/crawl4AI/.env
ExecStart=/home/himanshu/workspace/ai-agent/crawl4AI/venv_new/bin/arq worker.WorkerSettings
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
